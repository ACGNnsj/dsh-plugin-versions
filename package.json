{
  "name": "dsh-plugin-versions",
  "version": "0.1.2",
  "description": "List installed DeepSeek Harness bundles with versions and update status, and jump straight to the official update page.",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "license": "MIT",
  "author": "ACGNnsj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ACGNnsj/dsh-plugin-versions.git"
  },
  "homepage": "https://github.com/ACGNnsj/dsh-plugin-versions#readme",
  "bugs": {
    "url": "https://github.com/ACGNnsj/dsh-plugin-versions/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "plugin-manager",
    "versions",
    "update"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
