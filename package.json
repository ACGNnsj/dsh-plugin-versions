{
  "name": "dsh-plugin-versions",
  "version": "0.1.0",
  "private": true,
  "description": "List installed DSH bundles with their versions and update status, and open the official update page.",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": [] }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale", "icon.svg", "README.md"]
}
